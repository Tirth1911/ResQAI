# ==========================================
# ResQAI Platform Environment Configuration
# ==========================================

# Database: MongoDB ONLY (Local instance or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=resqai

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Incident Intelligence Engine Configuration
# Works with OpenAI, Groq, Ollama, vLLM, or any OpenAI-compatible API
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
ENABLE_AI_ANALYSIS=true

# Deduplication Thresholds
DEDUP_DISTANCE_THRESHOLD_KM=1.5
DEDUP_TIME_WINDOW_MINUTES=45

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
