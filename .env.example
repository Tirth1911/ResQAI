# ==============================================================================
# ResQAI Environment Configuration
# ==============================================================================

# Backend Database Configuration
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=resqai

# AI / LLM Configuration
# Provider: groq or openai
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_or_openai_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# CORS & Network
FRONTEND_ORIGIN=http://localhost:3000

# Triage & Deduplication Engine Tuning
DEDUP_DISTANCE_KM=1.0
DEDUP_WINDOW_MIN=45
DEDUP_SIM_THRESHOLD=0.35
DELAY_ALERT_MIN=10
ESCALATION_MIN=20

# Simulation & Demo
DEMO_MODE=false
DEMO_TIME_SCALE=1.0

# Frontend Configuration (for frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_DEMO=true
